model Test {
  id           String       @id @default(cuid())
  title        String
  description  String?
  type         String
  duration     Int          @default(60)
  passingScore Int          @default(70)
  createdById  String
  jobId        String?
  active        Boolean       @default(true)
  views         Int           @default(0)
  createdAt    DateTime     @default(now())
  createdBy    User         @relation("TestCreator", fields: [createdById], references: [id])
  questions    Question[]
  attempts     TestAttempt[]
}

model Question {
  id            String   @id @default(cuid())
  testId        String
  type          String
  text          String
  options       String?
  correctAnswer String?
  points        Int      @default(10)
  order         Int      @default(0)
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers       Answer[]
}

model TestAttempt {
  id          String    @id @default(cuid())
  testId      String
  userId      String
  status      String    @default("IN_PROGRESS")
  score       Int?
  passed      Boolean?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  proctored   Boolean   @default(false)
  tabSwitches Int       @default(0)
  test        Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     Answer[]
}

model Answer {
  id          String      @id @default(cuid())
  attemptId   String
  questionId  String
  value       String
  correct     Boolean?
  points      Int         @default(0)
  attempt     TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// Discount / waiver codes applied at checkout. All discount math is computed
// server-side (never trust the client); a 100% coupon activates access through a
// dedicated no-charge waiver path (see app/api/payment/redeem-waiver).
model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique              // stored UPPERCASE
  description    String?
  kind           String   @default("percent")  // "percent" | "fixed" | "waiver"
  value          Float    @default(0)          // percent 0-100, or fixed CHF; ignored for "waiver"
  audience       String   @default("all")       // "all" | "individual" | "employer"
  planId         String?                         // null = any plan
  maxRedemptions Int?                            // null = unlimited (global cap)
  redeemedCount  Int      @default(0)
  perUserLimit   Int      @default(1)            // per-user cap (0 = unlimited)
  active         Boolean  @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  redemptions    CouponRedemption[]
  @@index([active])
}

// Professional links (LinkedIn, GitHub, Linktree, website, portfolio, …) shown on
// a profile. Each is OWNERSHIP-VERIFIED: we issue a token the user places on the
// public page, then fetch it and confirm the token is present (SSRF-guarded).
model SocialLink {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    String                     // "linkedin" | "github" | "website" | "linktree" | ...
  url         String
  verified    Boolean   @default(false)
  verifyToken String                     // token the user must place on the page
  verifiedAt  DateTime?
  lastCheckedAt DateTime?
  createdAt   DateTime  @default(now())
  @@unique([userId, platform, url])
  @@index([userId])
}

// Verifiable certificates (internship completion, course, assessment, achievement).
// Publicly verifiable at /verify/cert/[verificationCode]; revocable; never deleted.
model Certificate {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation("CertRecipient", fields: [userId], references: [id], onDelete: Cascade)
  issuedById       String?
  title            String
  kind             String    @default("internship")   // internship | course | assessment | achievement
  serial           String    @unique                   // human-readable, e.g. VRT-2026-XXXXXX
  verificationCode String    @unique                   // opaque public verify code
  issuerName       String
  skills           String?                              // comma-separated
  note             String?
  revoked          Boolean   @default(false)
  revokedReason    String?
  verifyCount      Int       @default(0)
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime?
  @@index([userId])
}

model CouponRedemption {
  id              String   @id @default(cuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId          String
  planId          String?
  amountBeforeCHF Float
  amountAfterCHF  Float
  waiver          Boolean  @default(false)
  orderId         String?
  createdAt       DateTime @default(now())
  @@unique([couponId, userId])                   // enforces per-user single redemption
  @@index([userId])
}


