generator client {
  provider = "prisma-client-js"
}

datasource db {
  // LOCAL DEV = sqlite. TO DEPLOY: change provider to "postgresql" (the url is
  // already env-driven — just set DATABASE_URL to your Postgres string).
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  password         String
  avatar           String?
  headline         String?
  bio              String?
  location         String?
  resumeUrl        String?
  phone            String?
  source           String?        // provenance: "indeed", "signup", null=organic
  openToWork       Boolean        @default(false)  // LinkedIn-style "open to work" signal
  openToMentor     Boolean        @default(false)  // ELTOS: available to mentor others
  role             String         @default("JOBSEEKER")
  seniority        String         @default("MID")   // interviewer seniority band for interview governance: JUNIOR|MID|SENIOR|LEAD|EXECUTIVE
  paid             Boolean        @default(false)
  paidAt           DateTime?
  paymentId        String?
  plan             String         @default("free")   // subscription tier id
  planRenewsAt     DateTime?
  twoFactorEnabled Boolean        @default(false)
  twoFactorSecret  String?
  faceVector           String?
  faceVectorUpdatedAt  DateTime?
  faceChangeReported   Boolean   @default(false)
  faceChangeReason     String?
  faceChangeDate       DateTime?
  idType               String?
  idVerified       Boolean        @default(false)
  // Partner API: an admin must approve a company before its API-posted jobs go
  // public, and each job's apply link must sit on a domain the company verified.
  apiApproved      Boolean        @default(false)
  banned           Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  profile          Profile?
  jobs             Job[]
  applications     Application[]
  notifications    Notification[]
  connections      Connection[]   @relation("UserConnections")
  connectedTo      Connection[]   @relation("ConnectedToUser")
  education        Education[]
  experience       Experience[]
  skills           UserSkill[]
  loginAttempts    LoginAttempt[]
  sessions         Session[]
  employerGuarantee  EmployerGuarantee?
  applicantGuarantee ApplicantGuarantee?
  activityLogs       ActivityLog[]
  conversations      ConversationParticipant[]
  sentMessages       Message[]
  mailSent           Mail[]             @relation("MailFrom")
  mailReceived       Mail[]             @relation("MailTo")
  channelsCreated    Channel[]          @relation("ChannelCreator")
  channelMemberships ChannelMember[]
  channelPosts       ChannelPost[]
  channelReplies          ChannelReply[]
  jobCommunityMemberships JobCommunityMember[]
  jobCommunityPosts       JobCommunityPost[]
  jobCommunityReplies     JobCommunityReply[]
  professionalSpaces      ProfessionalSpaceMember[]
  spacePostsAuthored      ProfessionalSpacePost[]
  spaceRepliesAuthored    ProfessionalSpaceReply[]
  professionalPage        ProfessionalPage?
  pageFollows             PageFollow[]
  pagePostReplies         PagePostReply[]
  spacesCreated           ProfessionalSpace[]  @relation("SpaceCreator")
  testsCreated            Test[]               @relation("TestCreator")
  testAttempts            TestAttempt[]
  faceVectorHistory    FaceVectorHistory[]
  hostedInterviews     Interview[]            @relation("InterviewHost")
  interviewParticipations InterviewParticipant[]
  identityVerification IdentityVerification?
  webauthnCredentials  WebAuthnCredential[]
  emailDomains         EmailDomain[]
  ownedWorkspaces      Workspace[]          @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  media                MediaAsset[]
  companyFollows       CompanyFollow[]
  companiesOwned       Company[]            @relation("CompanyOwner")
  socialLinks          SocialLink[]
  calendarToken        String?              @unique   // secret for the subscribable interview calendar feed
  certificatesEarned   Certificate[]        @relation("CertRecipient")
  trialStartedAt       DateTime?            // 7-day Basic trial (unlocks Basic features + up to 10 applications)
  trialEndsAt          DateTime?
  internships          Internship[]         @relation("Intern")
  mentoring            Internship[]         @relation("Mentor")
  evaluationsReceived  Evaluation[]         @relation("EvalSubject")
  offersReceived       Offer[]              @relation("OfferCandidate")
  offersCreated        Offer[]              @relation("OfferCreator")
  scorecardsGiven      InterviewScorecard[] @relation("ScorecardPanelist")
  proctorSessions      ProctorSession[]     @relation("ProctorSubject")
  jobTemplates         JobTemplate[]        @relation("JobTemplateCreator")
  talentPools          TalentPool[]         @relation("TalentPoolOwner")
  talentMemberships    TalentPoolMember[]   @relation("TalentPoolMemberUser")
  referralsMade        Referral[]           @relation("ReferralReferrer")
  competencies         UserCompetency[]     @relation("UserCompetencyUser")
  coursesAuthored      Course[]             @relation("CourseAuthor")
  enrollments          Enrollment[]         @relation("EnrollmentUser")
  mentorshipsAsMentor  Mentorship[]         @relation("MentorshipMentor")
  mentorshipsAsMentee  Mentorship[]         @relation("MentorshipMentee")
  researchProjects     ResearchProject[]    @relation("ResearchOwner")
  researchOutputs      ResearchOutput[]     @relation("ResearchAuthor")
  researchReviews      ResearchReview[]     @relation("ResearchReviewer")
  grantsPosted         Grant[]              @relation("GrantPoster")
  grantApplications    GrantApplication[]   @relation("GrantApplicant")
  challengesSponsored  InnovationChallenge[] @relation("ChallengeSponsor")
  challengeSubmissions ChallengeSubmission[] @relation("ChallengeSubmitter")
}

// A structured internship engagement (native "InternshipOS"): a weekly milestone
// roadmap, a mentor, stipend, evaluations, and a PPO (pre-placement offer) path.
model Internship {
  id            String    @id @default(cuid())
  userId        String                                   // the intern
  user          User      @relation("Intern", fields: [userId], references: [id], onDelete: Cascade)
  mentorId      String?
  mentor        User?     @relation("Mentor", fields: [mentorId], references: [id])
  createdById   String?                                  // employer/admin who set it up
  jobId         String?                                  // originating internship posting, if any
  companyName   String
  title         String
  track         String?
  cohort        String?
  status        String    @default("ACTIVE")             // ACTIVE | COMPLETED | DROPPED
  ppoStatus     String    @default("NONE")               // NONE | CONSIDERING | OFFERED | ACCEPTED | DECLINED
  startedAt     DateTime  @default(now())
  durationWeeks Int       @default(8)
  stipendAmount Float?
  stipendCurrency String? @default("INR")
  completionPct Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  milestones    InternshipMilestone[]
  evaluations   Evaluation[]
  @@index([userId])
  @@index([mentorId])
}

model InternshipMilestone {
  id           String    @id @default(cuid())
  internshipId String
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  week         Int
  title        String
  status       String    @default("PENDING")             // PENDING | IN_PROGRESS | DONE
  dueAt        DateTime?
  completedAt  DateTime?
  note         String?
  @@index([internshipId])
}

// Structured human evaluation (weekly / milestone / final) — mentor or HR review.
model Evaluation {
  id           String    @id @default(cuid())
  internshipId String?
  internship   Internship? @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      User      @relation("EvalSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  reviewerId   String?
  reviewerName String
  kind         String    @default("weekly")              // weekly | milestone | final | peer | self
  period       String?                                   // e.g. "Week 3"
  scoresJson   String?                                   // JSON: dimension -> 0..5
  overall      Float?
  strengths    String?
  improvements String?
  note         String?
  createdAt    DateTime  @default(now())
  @@index([subjectId])
  @@index([internshipId])
}

// Company profile — a real employer page, not just a string on a job. Jobs link by
// company name; this holds the brand, about, HQ, size, logo and followers so the
// board has proper company hubs like a market-level portal.
model Company {
  id           String          @id @default(cuid())
  slug         String          @unique
  name         String
  tagline      String?
  about        String?
  website      String?
  industry     String?
  size         String?         // headcount band, e.g. "51-200"
  headquarters String?
  founded      Int?
  logoUrl      String?         // /api/media/:id if uploaded, else a monogram is rendered
  verified     Boolean         @default(false)
  ownerId      String?         // employer user who manages the page
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  owner        User?           @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  followers    CompanyFollow[]

  @@index([name])
  @@index([industry])
}

model CompanyFollow {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

// Uploaded media (avatars, company logos, résumés, photos). Bytes live in the DB
// so uploads survive serverless/ephemeral filesystems and behave identically on
// SQLite (BLOB) and Postgres (bytea) — no external object store needed. Images are
// resized + re-encoded in-house (client-side canvas) before they ever reach here.
model MediaAsset {
  id        String   @id @default(cuid())
  ownerId   String
  kind      String   // avatar | logo | resume | photo | cover
  mime      String
  size      Int      // bytes
  width     Int?
  height    Int?
  filename  String?
  data      Bytes
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, kind])
}

// ===================== Vrittih CRM (Phase 0) =====================

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  plan      String   @default("free")   // free/pro/agency/enterprise
  timezone  String   @default("Asia/Kolkata")
  country   String   @default("IN")
  settings  String   @default("{}")     // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]
  contacts  Contact[]
  activities Activity[]
  messages  ContactMessage[]
  forms     Form[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("member") // owner/admin/member/viewer
  joinedAt    DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, userId])
}

model Contact {
  id             String    @id @default(cuid())
  workspaceId    String
  createdById    String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  avatar         String?
  company        String?
  jobTitle       String?
  industry       String?
  website        String?
  city           String?
  country        String?
  stage          String    @default("LEAD") // LEAD/QUALIFIED/PROPOSAL/WON/LOST
  value          Float     @default(0)
  currency       String    @default("CHF")
  source         String?
  tags           String    @default("[]")   // JSON array
  notes          String?
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  activities     Activity[]
  messages       ContactMessage[]
  @@index([workspaceId])
  @@index([workspaceId, stage])
}

model Activity {
  id          String    @id @default(cuid())
  workspaceId String
  contactId   String
  actorId     String?
  type        String    // contact.created, stage.changed, message.sent, note.added, ...
  payload     String    @default("{}") // JSON
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@index([contactId, createdAt])
}

model ContactMessage {
  id           String    @id @default(cuid())
  workspaceId  String
  contactId    String
  senderId     String?
  direction    String    // in/out
  body         String
  status       String    @default("sent") // sending/sent/delivered/partial/read/failed
  readDepthPct Int       @default(0)
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@index([contactId, createdAt])
}

model Form {
  id          String           @id @default(cuid())
  workspaceId String
  createdById String
  slug        String           @unique
  name        String
  fields      String           @default("[]") // JSON: [{id,type,label,placeholder,required,options}]
  settings    String           @default("{}") // JSON: {successMessage, redirectUrl}
  isLive      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]
  @@index([workspaceId])
}

model FormSubmission {
  id          String   @id @default(cuid())
  formId      String
  workspaceId String
  data        String   // JSON map of fieldId -> value
  contactId   String?
  ipHash      String?
  submittedAt DateTime @default(now())
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  @@index([formId, submittedAt])
}

model EmailDomain {
  id            String    @id @default(cuid())
  userId        String
  domain        String    @unique
  selector      String    @default("vrittih")
  dkimPrivateKey String   // PKCS8 PEM
  dkimPublicKey String    // base64 SPKI DER (published in DNS)
  verifyToken   String    // random token published as a TXT record to prove ownership
  verified      Boolean   @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthChallenge {
  key       String   @id // e.g. "reg_<userId>" / "auth_<userId>"
  challenge String
  expiresAt DateTime
}

// In-house durable job queue (no Redis/BullMQ). Claimed + processed by server/worker.js.
model BackgroundJob {
  id          String    @id @default(cuid())
  type        String    // handler key, e.g. "notification.create", "email.send"
  payload     String    @default("{}") // JSON
  status      String    @default("queued") // queued | active | done | failed | dead
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  priority    Int       @default(0)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  result      String?   // JSON
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([status, runAt])
}

// ---------- Professional feed ----------
model Post {
  id        String        @id @default(cuid())
  authorId  String
  content   String
  createdAt DateTime      @default(now())
  likes     PostLike[]
  comments  PostComment[]
  @@index([createdAt])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([postId, userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([postId, createdAt])
}

model ProfileView {
  id        String   @id @default(cuid())
  viewerId  String
  profileId String
  createdAt DateTime @default(now())
  @@index([profileId, createdAt])
}

// In-house product analytics event stream.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String   // e.g. "job.apply", "contact.created", "signin.succeeded"
  userId    String?
  props     String   @default("{}") // JSON
  createdAt DateTime @default(now())
  @@index([name, createdAt])
  @@index([createdAt])
}

model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique // base64url
  publicKey    String    // JWK as JSON
  alg          Int       // COSE alg: -7 ES256, -257 RS256
  counter      Int       @default(0)
  name         String?   // user-visible label, e.g. "Windows Hello"
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Public API keys — companies integrate and upload jobs / connect systems.
model ApiKey {
  id         String    @id @default(cuid())
  keyHash    String    @unique          // sha256 of the token (raw shown once at issue)
  prefix     String                     // display prefix e.g. vk_live_ab12…
  employerId String                     // the company this key acts as
  label      String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  @@index([employerId])
}

// Outbound webhooks — a company subscribes an endpoint and we POST signed events
// (e.g. application.created) so their own systems react in real time.
model Webhook {
  id         String    @id @default(cuid())
  employerId String                     // the company that owns this subscription
  url        String                     // where we POST events
  secret     String                     // HMAC-SHA256 signing secret (shown once)
  events     String    @default("*")    // csv of event names, or "*" for all
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastStatus Int?                        // last HTTP status returned by the endpoint
  lastAt     DateTime?
  failCount  Int       @default(0)       // consecutive failures (auto-disables past a threshold)
  deliveries WebhookDelivery[]
  @@index([employerId])
}

model WebhookDelivery {
  id           String    @id @default(cuid())
  webhookId    String
  event        String
  payload      String                    // JSON body we send
  status       String    @default("pending") // pending | delivered | failed
  attempts     Int       @default(0)
  responseCode Int?
  lastError    String?
  nextRetryAt  DateTime?
  createdAt    DateTime  @default(now())
  webhook      Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  @@index([webhookId])
  @@index([status])
  @@index([nextRetryAt])
}

// A domain a partner company has proven it controls. A job posted via the API
// only goes public if its apply link is on one of these AND the company is
// admin-approved — the structural defense against fake listings.
model PartnerDomain {
  id         String    @id @default(cuid())
  employerId String
  domain     String                          // registrable host, e.g. acme.com
  token      String                          // vrittih-verify=<token>
  method     String    @default("dns")        // dns | file
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  @@unique([employerId, domain])
  @@index([domain])
}

// White-label brand for a partner: their own careers microsite at /c/<slug>
// (and, once a custom domain is pointed + added in Vercel, at their own domain),
// showing their jobs under their name/logo/colour while Vrittih runs the backend.
model PartnerBrand {
  id           String   @id @default(cuid())
  employerId   String   @unique
  slug         String   @unique                 // the unique public link: /c/<slug>
  name         String
  tagline      String?
  about        String?
  logoUrl      String?
  color        String   @default("#0F6E56")     // accent colour of the microsite
  customDomain String?                           // e.g. careers.acme.com (host->tenant)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([customDomain])
}

// Task / assignment management — the company assigns work to team members and
// tracks it to done. Scoped per employer; assignee is an Employee on the team.
model Task {
  id          String    @id @default(cuid())
  employerId  String                          // owning company (employer User.id)
  title       String
  description String?
  status      String    @default("TODO")      // TODO | DOING | DONE
  priority    String    @default("MEDIUM")     // LOW | MEDIUM | HIGH
  assigneeId  String?                          // Employee.id on this company's team
  dueAt       DateTime?
  createdById String                          // User.id who created it
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projectId   String?                          // Phase 5: link a task to a Project (kanban)
  @@index([employerId, status])
  @@index([assigneeId])
  @@index([projectId])
}

// ==== ICIRE — Career Intelligence (in-house knowledge graph) ====

// An uploaded/analyzed career document; rawText is parsed into structured signals.
model CareerDocument {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @default("resume") // resume|transcript|certificate|cover_letter|portfolio|other
  title     String?
  mediaId   String?                       // -> MediaAsset if a file was uploaded
  rawText   String                        // extracted text
  parsed    String   @default("{}")       // JSON structured extraction
  createdAt DateTime @default(now())
  @@index([userId])
}

// Per-applicant, per-skill proficiency with evidence (§5). One row per (user,skill).
model SkillProficiency {
  id              String   @id @default(cuid())
  userId          String
  skill           String                   // canonical skill name
  category        String   @default("backend")
  confidence      Float    @default(0)      // 0..1
  level           String   @default("Novice")
  implied         Boolean  @default(false)  // inferred vs demonstrated
  scores          String   @default("{}")   // JSON sub-scores
  evidence        String   @default("{}")   // JSON evidence
  updatedAt       DateTime @updatedAt
  @@unique([userId, skill])
  @@index([userId])
  @@index([skill])
}

// The assembled professional knowledge graph + summary for an applicant (§3).
model CareerProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  graph      String   @default("{}")       // JSON nodes/edges
  summary    String   @default("{}")       // JSON strengths, growth areas, stats
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// §20 continuous learning — immutable time series of proficiency snapshots. Gated
// (real content change OR >=30d) so growth is bounded. Drives growth/decay deltas.
model CareerSnapshot {
  id            String   @id @default(cuid())
  userId        String
  contentHash   String                       // sha256 of USER-AUTHORED input only
  trigger       String   @default("manual")  // manual|profile.*|resume|document|scheduled
  skillCount    Int      @default(0)
  explicitCount Int      @default(0)
  impliedCount  Int      @default(0)
  avgConfidence Float    @default(0)
  skillVector   String   @default("{}")      // JSON Record<skill,{c,l,i}>
  dna           String   @default("{}")      // JSON compact DNA signature for drift
  createdAt     DateTime @default(now())
  @@index([userId, createdAt])
}

// §20 — per-(user,job) roadmap progress. Self-reported task ticks live in `phases`;
// "skill closed" + matchDelta are RECOMPUTED from real analysis, never from ticks.
model RoadmapProgress {
  id            String   @id @default(cuid())
  userId        String
  jobId         String
  timeframeDays Int      @default(30)
  startMatch    Int      @default(0)          // frozen honest baseline at plan start
  targetMatch   Int      @default(0)          // buildRoadmap projectedMatch at start
  phases        String   @default("[]")       // JSON [{skill, tasksDone:boolean[]}]
  startedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([userId, jobId])                   // IDOR guard: key on token userId + jobId
  @@index([userId])
}

// §21 — aggregate, PII-free match calibration per cohort ("global"|"family:backend"…).
// Populated by cron/admin recompute over Application.snapshot; read via short cache.
model MatchCalibration {
  id            String   @id @default(cuid())
  cohort        String   @unique
  version       Int      @default(1)
  buckets       String   @default("[]")       // JSON per-score-decile stage rates (isotonic)
  skills        String   @default("{}")       // JSON Record<skill,{withN,withAdv,withoutN,withoutAdv}>
  baseAdvRate   Float    @default(0)
  sampleSize    Int      @default(0)          // decided applications (k-anonymity)
  jobCount      Int      @default(0)          // distinct jobs (k-anonymity)
  employerCount Int      @default(0)          // distinct employers (k-anonymity)
  computedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([cohort])
}

// ============================================================================
// AIOS — Self-Evolving Intelligence Platform (docs/ai/SELF_EVOLVING_INTELLIGENCE_ARCHITECTURE.md)
// All additive, both-DB safe (JSON as String), userId/ownerId scalar (no User
// back-relation), history never overwritten (revision tables). Foundation models
// are in-house deterministic providers — never auto-modified.
// ============================================================================

// §5 Model Registry — governs every inference provider (in-house today).
model ModelRegistry {
  id             String   @id @default(cuid())
  modelId        String   @unique              // e.g. tfidf-embed-v1
  provider       String   @default("in-house")
  version        String   @default("1")
  task           String                        // embedding|ranking|classification|prediction|extraction|...
  capabilities   String   @default("[]")       // JSON string[]
  maxContext     Int      @default(0)
  latencyMs      Int      @default(0)
  cost           Float    @default(0)           // in-house = 0
  securityClass  String   @default("internal")
  deploymentStatus String @default("active")    // active|shadow|deprecated|disabled
  health         String   @default("healthy")
  evalScores     String   @default("{}")        // JSON
  rollbackOf     String?
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// §9 Capability — the unit authorization/resolution derives from (never role).
model Capability {
  id           String   @id @default(cuid())
  capId        String   @unique               // e.g. career.coach.answer
  name         String
  description  String?
  provider     String                          // lib module / registered handler key
  inputs       String   @default("{}")         // JSON schema
  outputs      String   @default("{}")         // JSON schema
  permissions  String   @default("[]")         // JSON: required capability/entitlement keys
  safetyClass  String   @default("standard")   // standard|sensitive|forbidden-auto
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// §7 Agent registry — every AI capability is a registered agent.
model AgentDef {
  id             String   @id @default(cuid())
  agentId        String   @unique              // e.g. agent:career-coach
  name           String
  owner          String   @default("edurankai")
  purpose        String?
  capabilities   String   @default("[]")       // JSON capId[]
  permissions    String   @default("[]")       // JSON capability keys
  knowledgeSources String @default("[]")       // JSON
  memoryScope    String   @default("user")     // user|org|agent|session|none
  tools          String   @default("[]")       // JSON toolId[]
  dependencies   String   @default("[]")       // JSON agentId[]
  version        String   @default("1")
  lifecycle      String   @default("active")    // active|deprecated|retired
  status         String   @default("healthy")
  health         String   @default("{}")        // JSON
  evalScores     String   @default("{}")        // JSON
  auditRequirements String @default("standard")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// §21 Prompt/answer-template registry — governed assets, never scattered in code.
model PromptTemplate {
  id           String   @id @default(cuid())
  promptId     String                          // logical id (versioned by row)
  version      Int      @default(1)
  owner        String   @default("edurankai")
  description  String?
  template     String                          // the template text
  variables    String   @default("[]")         // JSON
  agents       String   @default("[]")         // JSON agentId[]
  safetyRules  String   @default("[]")         // JSON
  evalHistory  String   @default("[]")         // JSON
  approvedBy   String?
  rollbackOf   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  @@unique([promptId, version])
}

// §22 Tool registry.
model ToolDef {
  id           String   @id @default(cuid())
  toolId       String   @unique
  purpose      String?
  inputsSchema String   @default("{}")
  outputsSchema String  @default("{}")
  permissions  String   @default("[]")
  dependencies String   @default("[]")
  failureModes String   @default("[]")
  retryPolicy  String   @default("{}")
  timeoutMs    Int      @default(15000)
  audit        Boolean  @default(true)
  health       String   @default("healthy")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// §4/§32 Execution audit — one immutable row per AIOS.execute() call.
model AiRun {
  id           String   @id @default(cuid())
  subjectId    String?                          // acting user (null = system)
  agentId      String?                          // resolved agent, if any
  capId        String                           // capability executed
  modelId      String?                          // model selected
  inputsHash   String                           // sha256 of inputs (no PII stored)
  outputs      String   @default("{}")          // JSON (or ref)
  status       String   @default("ok")          // ok|denied|error|blocked
  latencyMs    Int      @default(0)
  cost         Float    @default(0)
  confidence   Float?                           // 0..1 when applicable
  explanation  String?                          // user-appropriate reason summary (§26)
  steps        String   @default("[]")          // JSON orchestration trace (§8)
  error        String?
  createdAt    DateTime @default(now())
  @@index([capId, createdAt])
  @@index([subjectId, createdAt])
  @@index([agentId, createdAt])
}

// §13/§14 Knowledge Layer — versioned, classified, governed.
model KnowledgeItem {
  id            String   @id @default(cuid())
  kind          String                          // policy|doc|career|research|hr|company|project|learning|community|structured|external
  title         String
  body          String   @default("")
  contentHash   String                          // dedupe (§13)
  status        String   @default("pending_review") // verified|unverified|pending_review|experimental|deprecated|rejected
  confidence    Float    @default(0)
  owner         String?
  provenance    String   @default("{}")         // JSON source/lineage
  securityClass String   @default("internal")
  reviewDate    DateTime?
  supersededById String?
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([kind, status])
  @@index([contentHash])
  @@index([status])
}

// §13 Immutable revision history — never overwrite knowledge.
model KnowledgeRevision {
  id           String   @id @default(cuid())
  itemId       String
  version      Int
  status       String
  title        String
  body         String   @default("")
  changedBy    String?
  reason       String?
  createdAt    DateTime @default(now())
  @@index([itemId, version])
}

// §16 In-house semantic index — sparse TF-IDF vectors + inverted postings.
model SemanticDoc {
  id           String   @id @default(cuid())
  refType      String                           // job|document|policy|course|research|skill|person|community|knowledge
  refId        String
  index        String   @default("default")     // which named index (§16)
  vector       String   @default("{}")          // JSON { term: weight } sparse
  norm         Float    @default(0)             // precomputed vector norm for cosine
  terms        Int      @default(0)
  contentHash  String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  @@unique([refType, refId, index])
  @@index([index])
}

// §16 Inverted index posting (term -> doc) for candidate retrieval.
model SemanticPosting {
  id        String @id @default(cuid())
  index     String @default("default")
  term      String
  docId     String                              // SemanticDoc.id
  weight    Float  @default(0)
  @@index([index, term])
  @@index([docId])
}

// §17 Enterprise memory — hierarchical, structured (never weights).
model MemoryEntry {
  id          String   @id @default(cuid())
  scope       String                            // working|session|conversation|agent|user|org|knowledge|collective|archive
  ownerId     String                            // user id, org id, or agent id per scope
  kind        String                            // goal|preference|skill|strength|weakness|style|achievement|interview|application|project|feedback|note
  key         String
  valueJson   String   @default("{}")
  confidence  Float    @default(0.5)
  source      String   @default("system")
  verified    Boolean  @default(false)
  expiresAt   DateTime?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([scope, ownerId, kind, key])
  @@index([ownerId, scope])
}

// §23 Event-driven learning — platform events, replayable, never overwritten.
model PlatformEvent {
  id          String   @id @default(cuid())
  type        String                            // job.created|application.submitted|...
  actorId     String?
  subjectId   String?                           // primary entity the event is about
  payload     String   @default("{}")           // JSON
  processed   Boolean  @default(false)
  handlers    String   @default("[]")           // JSON handler run log
  createdAt   DateTime @default(now())
  processedAt DateTime?
  @@index([type, createdAt])
  @@index([processed])
}

// §25/§29 Self-evaluation runs + metrics (trends over time).
model EvalRun {
  id         String   @id @default(cuid())
  metric     String                             // recommendation_accuracy|retrieval_accuracy|knowledge_freshness|...
  scope      String   @default("global")
  value      Float
  sampleSize Int      @default(0)
  detail     String   @default("{}")            // JSON
  createdAt  DateTime @default(now())
  @@index([metric, createdAt])
}

// §27/§28 Human-review change proposals — AI proposes, humans approve. Never self-approved.
model ChangeProposal {
  id          String   @id @default(cuid())
  kind        String                            // policy|compliance|hiring|legal|org|prompt|knowledge|maintenance|governance
  title       String
  rationale   String   @default("")
  payload     String   @default("{}")           // JSON proposed change
  status      String   @default("pending")      // pending|approved|rejected|applied
  proposedBy  String   @default("aios")
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, kind])
}

// §18 Adaptive recommendations + feedback (generalizes §21 calibration).
model Recommendation {
  id          String   @id @default(cuid())
  subjectId   String                            // user recommended to
  domain      String                            // job|skill|course|path|action|...
  itemRef     String                            // what was recommended (id or key)
  context     String   @default("{}")           // JSON
  score       Float    @default(0)
  modelId     String?
  agentId     String?
  createdAt   DateTime @default(now())
  @@index([subjectId, domain, createdAt])
}

model RecommendationFeedback {
  id      String   @id @default(cuid())
  recId   String
  subjectId String
  signal  String                                // helpful|not_helpful|accepted|ignored|completed|failed|successful|rejected
  detail  String   @default("{}")
  createdAt DateTime @default(now())
  @@index([recId])
  @@index([signal, createdAt])
}

// ---- HRMS ----
model Employee {
  id             String    @id @default(cuid())
  userId         String                          // the person (User)
  employerId     String                          // the company (employer User)
  employeeCode   String                          // e.g. EMP-0001
  department     String?
  designation    String?
  employmentType String    @default("Full-time") // Full-time/Part-time/Contract/Intern
  status         String    @default("ONBOARDING")// ONBOARDING/ACTIVE/ON_LEAVE/EXITED
  managerId      String?                         // another Employee id
  salary         String?                         // CHF
  workLocation   String?
  joinedAt       DateTime  @default(now())
  onboarding     String    @default("[]")        // JSON [{label,done}]
  offboarding    String    @default("[]")        // JSON [{label,done}] — Phase 4 exit checklist
  exitedAt       DateTime?                        // set when status → EXITED
  leaveBalance   Int       @default(24)          // annual days
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  leaves         LeaveRequest[]
  attendance     Attendance[]
  compensation   Compensation?
  @@unique([employerId, userId])
  @@index([employerId, status])
}

// ===================== Payroll =====================
// An employee's current salary structure. Components are stored as JSON so an
// employer can model any pay stack (basic, HRA, allowances, PF, professional tax,
// insurance) without a schema change per country.
//
// IMPORTANT: this is a payroll ENGINE, not a statutory-compliance product. Rates
// and rules are supplied by the employer and are not warranted to satisfy any
// jurisdiction's tax or social-security law. Have your finance team or chartered
// accountant verify the structure before you pay anyone from it.
model Compensation {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  currency      String   @default("INR")
  annualCTC     Float                       // cost to company, in `currency`
  components    String   @default("[]")     // JSON [{name,kind:earning|deduction,calc:fixed|pct_basic|pct_ctc,value,statutory?}]
  effectiveFrom DateTime @default(now())
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// One payroll cycle for one employer (a calendar month).
model PayrollRun {
  id          String    @id @default(cuid())
  employerId  String
  periodYear  Int
  periodMonth Int                            // 1-12
  status      String    @default("DRAFT")    // DRAFT | APPROVED | PAID | CANCELLED
  currency    String    @default("INR")
  totalGross  Float     @default(0)
  totalDeduct Float     @default(0)
  totalNet    Float     @default(0)
  headcount   Int       @default(0)
  note        String?
  approvedAt  DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payslips    Payslip[]

  @@unique([employerId, periodYear, periodMonth])
  @@index([employerId, status])
}

model Payslip {
  id         String     @id @default(cuid())
  runId      String
  employeeId String
  currency   String
  gross      Float
  deductions Float
  net        Float
  lines      String     @default("[]")       // JSON [{name,kind,amount}] — the full breakdown
  lopDays    Float      @default(0)          // loss-of-pay days applied
  paidDays   Float      @default(0)
  createdAt  DateTime   @default(now())
  run        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, employeeId])
  @@index([employeeId])
}

model Attendance {
  id          String    @id @default(cuid())
  employeeId  String
  date        DateTime                          // the day (stored at UTC midnight)
  checkIn     DateTime?
  checkOut    DateTime?
  status      String    @default("PRESENT")     // PRESENT/LATE/ABSENT/HALF_DAY/LEAVE/HOLIDAY/REMOTE
  method      String    @default("manual")      // manual/face/self
  workedMins  Int       @default(0)
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@unique([employeeId, date])
  @@index([employeeId, date])
}

model LeaveRequest {
  id         String    @id @default(cuid())
  employeeId String
  type       String    @default("Annual")   // Annual/Sick/Casual/Unpaid
  startDate  DateTime
  endDate    DateTime
  days       Int       @default(1)
  reason     String?
  status     String    @default("PENDING")  // PENDING/APPROVED/REJECTED
  note       String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([employeeId, status])
}

// Saved / bookmarked jobs (scalar ids, batch-fetched — matches Post/ProfileView convention).
model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

model Profile {
  id        String    @id @default(cuid())
  userId    String    @unique
  website   String?
  github    String?
  linkedin  String?
  twitter   String?
  birthDate DateTime?         // for in-house astrological / guna / dosha analysis
  birthTime String?           // optional HH:mm for finer Vedic reading
  birthPlace String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id           String        @id @default(cuid())
  title        String
  description  String
  company      String
  industry     String
  location     String
  type         String
  salary       String?
  remote       Boolean       @default(false)
  // Where a candidate can apply. Vrittih's own tracked flow is always available;
  // these add the official routes for aggregated / public-sector listings.
  applyUrl     String?       // the company's or department's own careers page for this role
  govUrl       String?       // the official government portal listing (public-sector roles)
  // "Is this still open?" is the whole game for public-sector listings — people
  // waste hours on portals only to find a notice has closed. null = no stated date.
  closesAt     DateTime?     // application deadline
  govBody      String?       // recruiting authority, e.g. "Staff Selection Commission"
  // Ingestion provenance. externalId is the source's own id so re-running an
  // import updates rather than duplicates.
  sourceKey    String?       // JobSource.key, e.g. "ncs" — null for natively posted jobs
  externalId   String?
  active        Boolean       @default(true)
  views         Int           @default(0)
  postedById   String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  postedBy     User          @relation(fields: [postedById], references: [id])
  applications Application[]
  skills        JobSkill[]
  community     JobCommunity?
  form          ApplicationForm?

  @@unique([sourceKey, externalId])
  @@index([company])
  @@index([active])
  @@index([postedById])
  @@index([createdAt])
  @@index([closesAt])
  @@index([sourceKey])
}

// A registered ingestion source (a government portal, a partner feed, an API
// client). Each source has an adapter in lib/sources that turns whatever the
// portal publishes into normalised listings; this row tracks health so a silently
// broken scraper is visible instead of quietly serving stale jobs.
model JobSource {
  key         String    @id                      // "ncs", "ssc", …
  name        String
  homepage    String
  kind        String    @default("government")   // government | private | partner
  region      String?                            // "India", "Assam", …
  // A site publishes its open roles at this URL (JSON) and Vrittih ingests it on
  // a schedule — no database access to the site, ever. This is how any new site
  // is connected: register a row with its feedUrl. null = code-defined adapter.
  feedUrl     String?
  active      Boolean   @default(true)
  lastRunAt   DateTime?
  lastOk      Boolean?
  lastMessage String?
  found       Int       @default(0)              // listings seen on the last run
  imported    Int       @default(0)              // created + updated on the last run
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Application {
  id          String        @id @default(cuid())
  userId      String
  jobId       String
  status      String        @default("APPLIED")
  coverLetter String?
  appliedAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  interview   DateTime?
  notes       String?
  source      String?       // "indeed" for imported applications, else null
  // What the candidate actually submitted, frozen at submit time. Their live
  // profile can change afterwards; an employer must be able to see what they were
  // sent, and a candidate must not be judged on a version they did not send.
  snapshot    String?       // JSON { name, headline, email, phone, location, experience[], education[], skills[] }
  resumeUrl   String?       // the résumé attached to THIS application
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  timeline    StatusEvent[]
  answers     ApplicationAnswer[]
  documents   ApplicationDocument[]
  offers      Offer[]
  @@index([jobId, status])
  @@index([userId])
}

// EROS Module 8 — Offer Management. An Offer is a first-class entity, NOT an
// application status: it carries compensation, an approval + versioning lifecycle,
// and a digital acceptance that (on accept) drives the application to HIRED and can
// trigger onboarding. Compensation stores an explicit currency (FX-safe).
model Offer {
  id             String   @id @default(cuid())
  applicationId  String?              // link to the application, if offered from one
  candidateId    String               // the User being offered
  jobId          String?
  createdById    String               // recruiter / hiring manager who drafted it
  title          String               // role title on the offer
  companyName    String
  status         String   @default("DRAFT") // DRAFT|PENDING_APPROVAL|APPROVED|SENT|ACCEPTED|DECLINED|WITHDRAWN|EXPIRED
  // compensation (currency explicit; never sum across currencies without lib/fx)
  baseAmount     Float?
  currency       String   @default("CHF")
  bonusAmount    Float?
  equity         String?              // free text, e.g. "0.10%"
  benefits       String?              // JSON array of strings
  startDate      DateTime?
  expiresAt      DateTime?
  // approval
  approvedById   String?
  approvedAt     DateTime?
  // lifecycle
  sentAt         DateTime?
  respondedAt    DateTime?
  declineReason  String?
  // versioning — a revision supersedes the prior offer
  version        Int      @default(1)
  supersededById String?
  // prediction snapshot at send time (deterministic, explainable)
  acceptScore    Float?               // 0..1 predicted acceptance
  acceptFactors  String?              // JSON factors behind the prediction
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  candidate      User     @relation("OfferCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy      User     @relation("OfferCreator", fields: [createdById], references: [id], onDelete: Cascade)
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  events         OfferEvent[]
  @@index([candidateId, status])
  @@index([createdById, status])
}

model OfferEvent {
  id        String   @id @default(cuid())
  offerId   String
  action    String                    // created|submitted|approved|sent|accepted|declined|withdrawn|revised|expired
  note      String?
  actorId   String?
  createdAt DateTime @default(now())
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  @@index([offerId])
}

// EROS Module 3 — Job Architecture. A versioned, governed role/requisition template:
// family + level + grade + competencies + skills + an (in-house generated) JD, moving
// through a draft→approval lifecycle. Reused to post consistent, approved jobs.
model JobTemplate {
  id                    String   @id @default(cuid())
  createdById           String
  family                String?                     // lib/career/roles.ts family key
  level                 String   @default("MID")    // lib/jobarch/jd.ts LEVELS key
  grade                 String?                      // optional job-grade label
  title                 String
  summary               String?
  descriptionMd         String?                      // JD markdown (generated or edited)
  requiredSkills        String?                      // JSON string[]
  preferredSkills       String?                      // JSON string[]
  requiredCompetencies  String?                      // JSON [{key,label}]
  preferredCompetencies String?                      // JSON [{key,label}]
  status                String   @default("DRAFT")   // DRAFT|PENDING_APPROVAL|APPROVED|ARCHIVED
  version               Int      @default(1)
  supersededById        String?
  approvedById          String?
  approvedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdBy             User     @relation("JobTemplateCreator", fields: [createdById], references: [id], onDelete: Cascade)
  @@index([createdById, status])
  @@index([family, level])
}

// EROS Module 4 — Talent CRM. A recruiter's talent pool (pipeline of a given kind) and
// its members (platform users or external candidates), each at a relationship stage.
model TalentPool {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  kind        String   @default("POOL")   // POOL|SILVER_MEDALIST|CAMPUS|ALUMNI|REFERRAL|PASSIVE|COMMUNITY|RESEARCH
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation("TalentPoolOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TalentPoolMember[]
  @@index([ownerId, kind])
}

model TalentPoolMember {
  id             String   @id @default(cuid())
  poolId         String
  userId         String?                    // linked platform user, if known
  email          String?                    // external/passive candidate not yet on-platform
  name           String?
  stage          String   @default("NEW")   // NEW|CONTACTED|ENGAGED|INTERESTED|NURTURING|CONVERTED|DORMANT
  note           String?
  source         String?
  addedById      String
  addedAt        DateTime @default(now())
  lastActivityAt DateTime?
  pool           TalentPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  member         User?      @relation("TalentPoolMemberUser", fields: [userId], references: [id], onDelete: SetNull)
  @@index([poolId, stage])
}

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  candidateEmail String
  candidateName  String?
  jobId          String?
  relationship   String?                    // how the referrer knows them
  status         String   @default("SUBMITTED") // SUBMITTED|REVIEWING|INTERVIEWING|HIRED|REJECTED
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  referrer       User     @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  @@index([referrerId])
  @@index([jobId, status])
}

// ELTOS Module 1 — Enterprise Competency Framework (the spine). A competency is the
// atomic unit of human capability; it references the SAME skill graph as recruitment
// (lib/career/taxonomy) and forms a graph via parentId. Everything learned/done produces
// evidence that rolls up into UserCompetency proficiency.
model Competency {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  kind        String   @default("technical") // technical|behavioural|leadership|research|teaching|communication|innovation|future
  description String?
  category    String?                         // taxonomy Category
  skills      String?                         // JSON string[] of mapped taxonomy skills
  parentId    String?                         // competency graph / hierarchy
  levelBands  String?                         // JSON [{band,descriptor}] (optional)
  version     Int      @default(1)
  published   Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([kind])
  @@index([published])
}

model UserCompetency {
  id            String   @id @default(cuid())
  userId        String
  competencyKey String
  proficiency   Float    @default(0)          // 0..1, evidence-based (lib/learning/competency)
  source        String?                        // assessment|project|course|endorsement|self
  evidenceRef   String?
  assessedAt    DateTime @default(now())
  user          User     @relation("UserCompetencyUser", fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, competencyKey])
  @@index([competencyKey])
}

// ELTOS Modules 3/4 — Content Platform. A Course is a competency-mapped learning
// experience made of ordered Lessons; completion produces competency evidence + a cert.
model Course {
  id           String   @id @default(cuid())
  slug         String   @unique
  authorId     String
  title        String
  summary      String?
  level        String   @default("MID")   // lib/jobarch/jd LEVELS
  category     String?                     // taxonomy Category
  skills       String?                     // JSON string[] taught
  competencies String?                     // JSON string[] competency keys this course develops
  status       String   @default("DRAFT")  // DRAFT | PUBLISHED | ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       User     @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  enrollments  Enrollment[]
  @@index([status, category])
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  order       Int      @default(0)
  section     String?
  title       String
  type        String   @default("reading") // reading|video|exercise|quiz|project
  contentMd   String?
  resourceUrl String?
  durationMin Int      @default(10)
  skill       String?
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@index([courseId, order])
}

model Enrollment {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  status          String   @default("ACTIVE") // ACTIVE | COMPLETED
  progressPct     Int      @default(0)
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  certificateCode String?                       // set when a completion certificate is issued
  user            User     @relation("EnrollmentUser", fields: [userId], references: [id], onDelete: Cascade)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress        LessonProgress[]
  @@unique([userId, courseId])
  @@index([courseId, status])
}

model LessonProgress {
  id           String   @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  @@unique([enrollmentId, lessonId])
}

// ELTOS Module 8 — Mentoring & Coaching. Mentors surface by demonstrated competency
// proficiency + an opt-in; a mentorship is a governed relationship between two users.
model Mentorship {
  id            String   @id @default(cuid())
  mentorId      String
  menteeId      String
  competencyKey String?
  message       String?
  status        String   @default("REQUESTED") // REQUESTED|ACTIVE|DECLINED|COMPLETED|WITHDRAWN
  createdAt     DateTime @default(now())
  respondedAt   DateTime?
  mentor        User     @relation("MentorshipMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee        User     @relation("MentorshipMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  @@index([mentorId, status])
  @@index([menteeId, status])
}

// ===== Phase 3 — Enterprise Research & Innovation Platform (ERIP) =====
model ResearchProject {
  id           String   @id @default(cuid())
  ownerId      String
  title        String
  abstract     String?
  field        String?
  competencies String?                          // JSON string[] research competencies advanced
  status       String   @default("ACTIVE")      // PROPOSED|ACTIVE|COMPLETED|ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  owner        User     @relation("ResearchOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  outputs      ResearchOutput[]
  @@index([ownerId, status])
}

model ResearchOutput {
  id           String   @id @default(cuid())
  projectId    String?
  authorId     String
  title        String
  kind         String   @default("paper")       // paper|preprint|patent|dataset|report
  abstract     String?
  venue        String?
  url          String?
  doi          String?
  competencies String?                          // JSON string[]
  status       String   @default("DRAFT")        // DRAFT|UNDER_REVIEW|PUBLISHED|REJECTED|WITHDRAWN
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       User     @relation("ResearchAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  project      ResearchProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reviews      ResearchReview[]
  @@index([status, kind])
  @@index([authorId])
}

model ResearchReview {
  id             String   @id @default(cuid())
  outputId       String
  reviewerId     String
  recommendation String                         // ACCEPT|MINOR|MAJOR|REJECT
  score          Int?                            // 0..10
  comments       String?
  createdAt      DateTime @default(now())
  output         ResearchOutput @relation(fields: [outputId], references: [id], onDelete: Cascade)
  reviewer       User           @relation("ResearchReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  @@unique([outputId, reviewerId])
}

model Citation {
  id           String   @id @default(cuid())
  fromOutputId String
  toOutputId   String?
  externalRef  String?
  createdAt    DateTime @default(now())
  @@index([toOutputId])
  @@index([fromOutputId])
}

model Grant {
  id          String   @id @default(cuid())
  postedById  String
  title       String
  funder      String?
  amount      Float?
  currency    String   @default("CHF")
  field       String?
  description String?
  status      String   @default("OPEN")          // OPEN|CLOSED
  deadline    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  postedBy    User     @relation("GrantPoster", fields: [postedById], references: [id], onDelete: Cascade)
  applications GrantApplication[]
  @@index([status])
}

model GrantApplication {
  id          String   @id @default(cuid())
  grantId     String
  applicantId String
  projectId   String?
  summary     String?
  status      String   @default("SUBMITTED")     // SUBMITTED|SHORTLISTED|AWARDED|REJECTED
  createdAt   DateTime @default(now())
  grant       Grant    @relation(fields: [grantId], references: [id], onDelete: Cascade)
  applicant   User     @relation("GrantApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  @@unique([grantId, applicantId])
}

model InnovationChallenge {
  id          String   @id @default(cuid())
  sponsorId   String
  title       String
  description String?
  prize       String?
  status      String   @default("OPEN")          // OPEN|JUDGING|CLOSED
  deadline    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sponsor     User     @relation("ChallengeSponsor", fields: [sponsorId], references: [id], onDelete: Cascade)
  submissions ChallengeSubmission[]
  @@index([status])
}

model ChallengeSubmission {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  title       String
  summary     String?
  url         String?
  status      String   @default("SUBMITTED")     // SUBMITTED|SHORTLISTED|WINNER|REJECTED
  createdAt   DateTime @default(now())
  challenge   InnovationChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User     @relation("ChallengeSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  @@unique([challengeId, userId])
}

// ===== Phase 4 — HRMS Performance & Development lifecycle =====
// (Scalar user ids by design — no new User back-relations; names resolved in the API.)
model Goal {
  id          String   @id @default(cuid())
  ownerId     String                            // whose goal (User id)
  createdById String
  title       String
  description String?
  keyResults  String   @default("[]")           // JSON [{text,target,current,unit}]
  progress    Int      @default(0)
  period      String?
  status      String   @default("ACTIVE")        // ACTIVE|ACHIEVED|MISSED|DROPPED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([ownerId, status])
}

model PerformanceReview {
  id          String   @id @default(cuid())
  subjectId   String                            // the person being reviewed (User id)
  reviewerId  String
  period      String?
  ratingsJson String   @default("[]")           // JSON [{competencyKey, rating 1..5}]
  overall     Int?
  summary     String?
  status      String   @default("DRAFT")         // DRAFT|SUBMITTED|ACKNOWLEDGED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([subjectId, status])
  @@index([reviewerId])
}

model OneOnOne {
  id          String   @id @default(cuid())
  managerId   String
  employeeId  String
  notes       String?
  scheduledAt DateTime?
  createdAt   DateTime @default(now())
  @@index([managerId])
  @@index([employeeId])
}

model Recognition {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  message   String
  badge     String?
  createdAt DateTime @default(now())
  @@index([toId])
}

model SuccessionPlan {
  id            String   @id @default(cuid())
  ownerId       String
  positionTitle String
  incumbentId   String?
  candidates    String   @default("[]")          // JSON [{name,userId?,readiness,note}]
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([ownerId])
}

// ===== Phase 5 — Enterprise Project & Collaboration =====
// (Scalar user ids by design; reuses the existing Task model for the board.)
model Project {
  id          String   @id @default(cuid())
  ownerId     String                            // creator (User id)
  employerId  String?                           // owning company
  name        String
  description String?
  status      String   @default("ACTIVE")        // PLANNING|ACTIVE|ON_HOLD|DONE|ARCHIVED
  startAt     DateTime?
  dueAt       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  milestones  Milestone[]
  @@index([ownerId, status])
}

model Milestone {
  id        String   @id @default(cuid())
  projectId String
  title     String
  status    String   @default("PENDING")         // PENDING|IN_PROGRESS|DONE
  dueAt     DateTime?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
}

model WikiPage {
  id          String   @id @default(cuid())
  ownerId     String
  projectId   String?
  title       String
  contentMd   String   @default("")
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([ownerId])
  @@index([projectId])
}

// ===== Phase 6 — Enterprise ERP (Finance) =====
model Vendor {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  contact     String?
  category    String?
  createdAt   DateTime @default(now())
  @@index([ownerId])
}

model PurchaseOrder {
  id         String   @id @default(cuid())
  ownerId    String
  vendorId   String?
  title      String
  amount     Float    @default(0)
  currency   String   @default("CHF")
  status     String   @default("DRAFT")          // DRAFT|OPEN|RECEIVED|CLOSED|CANCELLED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([ownerId, status])
}

model Invoice {
  id         String   @id @default(cuid())
  ownerId    String
  number     String
  client     String?
  amount     Float    @default(0)
  currency   String   @default("CHF")
  status     String   @default("DRAFT")          // DRAFT|SENT|PAID|OVERDUE|VOID
  dueAt      DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([ownerId, status])
}

model Expense {
  id         String   @id @default(cuid())
  ownerId    String
  category   String   @default("general")
  description String?
  amount     Float    @default(0)
  currency   String   @default("CHF")
  status     String   @default("SUBMITTED")       // SUBMITTED|APPROVED|REJECTED|REIMBURSED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([ownerId, status])
}

model Budget {
  id        String   @id @default(cuid())
  ownerId   String
  category  String
  amount    Float    @default(0)
  currency  String   @default("CHF")
  period    String?
  createdAt DateTime @default(now())
  @@index([ownerId])
}

// What a given job requires of an applicant. Employers differ: some want a CV
// only, some want screening questions, documents and an assessment. Stored per
// job so the applicant sees exactly what is being asked before they start.
model ApplicationForm {
  id             String   @id @default(cuid())
  jobId          String   @unique
  useProfile     Boolean  @default(true)   // prefill from the candidate's profile
  requireResume  Boolean  @default(true)
  coverLetter    String   @default("optional") // required | optional | off
  questions      String   @default("[]")   // JSON [{id,label,type,options[],required,help}]
  documents      String   @default("[]")   // JSON [{id,label,required,accept,help}]
  testId         String?                   // assessment the candidate must complete
  testRequired   Boolean  @default(false)
  instructions   String?                   // shown at the top of the application
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model ApplicationAnswer {
  id            String      @id @default(cuid())
  applicationId String
  questionId    String
  label         String      // frozen: the question as it was asked
  value         String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId])
}

model ApplicationDocument {
  id            String      @id @default(cuid())
  applicationId String
  slotId        String      // matches the requirement's id
  label         String      // frozen: what was asked for
  mediaId       String      // -> MediaAsset, served from /api/media/:id
  filename      String?
  size          Int         @default(0)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId])
}

model StatusEvent {
  id            String      @id @default(cuid())
  applicationId String
  status        String
  note          String?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Connection {
  id          String   @id @default(cuid())
  userId      String
  connectedId String
  status      String   @default("PENDING")
  user        User     @relation("UserConnections", fields: [userId], references: [id])
  connected   User     @relation("ConnectedToUser", fields: [connectedId], references: [id])
}

model Education {
  id        String  @id @default(cuid())
  userId    String
  school    String
  degree    String
  field     String
  startYear Int
  endYear   Int?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Experience {
  id          String    @id @default(cuid())
  userId      String
  company     String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id    String      @id @default(cuid())
  name  String      @unique
  users UserSkill[]
  jobs  JobSkill[]
}

model UserSkill {
  userId  String
  skillId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id])
  @@id([userId, skillId])
}

model JobSkill {
  jobId   String
  skillId String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id])
  @@id([jobId, skillId])
}

model EmployerGuarantee {
  id              String   @id @default(cuid())
  employerId      String   @unique
  freePostUsed    Boolean  @default(false)
  freePostJobId   String?
  totalHired      Int      @default(0)
  createdAt       DateTime @default(now())
  employer        User     @relation(fields: [employerId], references: [id], onDelete: Cascade)
}

model ApplicantGuarantee {
  id                  String   @id @default(cuid())
  applicantId         String   @unique
  totalApplications   Int      @default(0)
  failedAttempts      Int      @default(0)
  supportTriggeredAt  DateTime?
  supportStatus       String   @default("NONE")
  supportNote         String?
  createdAt           DateTime @default(now())
  applicant           User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  meta      String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Conversation {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  type           String       @default("TEXT")
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// Platform-wide key/value settings, controlled from the super-admin panel.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}



model Mail {
  id          String   @id @default(cuid())
  fromId      String
  toId        String
  subject     String
  body        String
  read        Boolean  @default(false)
  starred     Boolean  @default(false)
  archived    Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  from        User     @relation("MailFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to          User     @relation("MailTo", fields: [toId], references: [id], onDelete: Cascade)
}


model Channel {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  type        String          @default("PUBLIC")
  createdById String
  createdAt   DateTime        @default(now())
  createdBy   User            @relation("ChannelCreator", fields: [createdById], references: [id])
  members     ChannelMember[]
  posts       ChannelPost[]
}

model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([channelId, userId])
}

model ChannelPost {
  id        String        @id @default(cuid())
  channelId String
  userId    String
  content   String
  pinned    Boolean       @default(false)
  createdAt DateTime      @default(now())
  channel   Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   ChannelReply[]
}

model ChannelReply {
  id        String      @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime    @default(now())
  post      ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model FaceVectorHistory {
  id               String   @id @default(cuid())
  userId           String
  vector           String
  reason           String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IdentityVerification {
  id               String   @id @default(cuid())
  userId           String   @unique
  idType           String
  idNumberHash     String
  nameOnDoc        String
  nameMatchScore   Float
  faceMatchScore   Float
  verifiedAt       DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Interview {
  id            String    @id @default(cuid())
  title         String
  type          String    @default("ONE_ON_ONE")
  status        String    @default("SCHEDULED")
  scheduledAt   DateTime
  duration      Int       @default(60)
  hostId        String
  applicationId String?
  roomCode      String    @unique
  recordingUrl  String?
  notes         String?
  // Who-may-attend governance
  visibility    String    @default("PARTICIPANTS") // PARTICIPANTS | COMPANY | LINK — who may view/join
  roleLevel     String?   // seniority band of the position: IC | SENIOR | LEAD | EXECUTIVE
  confidential  Boolean   @default(false)          // hides notes/recording from OBSERVER-role attendees
  govJson       String?   // snapshot of the governance evaluation at schedule time (violations/warnings/overrides)
  createdAt     DateTime  @default(now())
  host          User      @relation("InterviewHost", fields: [hostId], references: [id])
  participants  InterviewParticipant[]
}

model InterviewParticipant {
  id          String    @id @default(cuid())
  interviewId String
  userId      String
  role        String    @default("CANDIDATE")
  joinedAt    DateTime?
  leftAt      DateTime?
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([interviewId, userId])
}

// EROS Module 6 — structured, competency-based interview evaluation. One scorecard per
// panelist per interview; aggregated (lib/interview/scorecard.ts) into a panel result
// with explainable bias/process signals. Evidence-based, human-authored.
model InterviewScorecard {
  id             String   @id @default(cuid())
  interviewId    String?
  applicationId  String?
  panelistId     String
  competencySet  String   @default("default")
  ratingsJson    String                        // { competencyKey: 1..4 }
  recommendation String                        // STRONG_NO | NO | YES | STRONG_YES
  notes          String?
  submittedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
  panelist       User     @relation("ScorecardPanelist", fields: [panelistId], references: [id], onDelete: Cascade)
  @@unique([interviewId, panelistId])
  @@index([applicationId])
}

// EROS Module 6/7 — Semantic Proctoring (Phase 1). A session groups typed, consented
// integrity EVENTS for one candidate in one interview/assessment. NO raw media, NO
// character/emotion inference — observable events only, and a HUMAN makes the call.
model ProctorSession {
  id           String   @id @default(cuid())
  kind         String                          // interview | assessment
  refId        String                          // interviewId or testAttemptId
  subjectId    String                          // the candidate being observed
  consent      Boolean  @default(false)        // explicit, revocable candidate consent
  consentAt    DateTime?
  status       String   @default("ACTIVE")     // ACTIVE | ENDED
  riskScore    Float    @default(0)            // 0..100 deterministic aggregate (lib/proctor)
  reviewStatus String   @default("PENDING")    // PENDING | CLEARED | FLAGGED (human-set)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  subject      User     @relation("ProctorSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  events       ProctorEvent[]
  @@index([kind, refId])
  @@index([reviewStatus])
  @@index([subjectId])
}

model ProctorEvent {
  id           String   @id @default(cuid())
  sessionId    String
  type         String                          // face.absent | window.blur | clipboard.paste | ...
  source       String   @default("browser")    // browser | device | network (phase2: vision, on-device)
  ts           DateTime @default(now())
  confidence   Float    @default(1)
  severity     String   @default("info")       // info | low | medium | high (classified in-house)
  evidence     String?                         // JSON metadata only — NEVER raw media
  policyRef    String?
  linkedIds    String?                         // JSON array of linked event ids
  reviewStatus String   @default("NONE")       // NONE | CONFIRMED | DISMISSED (human)
  session      ProctorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
  @@index([type])
}


model JobCommunity {
